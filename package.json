{
  "name": "abcdesk-web",
  "version": "1.0.0",
  "description": "ABC Desk Web: a browser workbench for ABC notation with live rendering, playback and diagnostics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "audit": "npm audit --audit-level=high",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run audit && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "abc-notation",
    "abcjs",
    "sheet-music",
    "music-editor"
  ],
  "author": "Maribbit",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "abcjs": "^6.6.3",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
